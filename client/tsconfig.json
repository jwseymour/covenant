{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "jsx": "react-jsx",
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true
    },
    "include": [
        "src/**/*"
    ],
    "references": [
        {
            "path": "../shared"
        }
    ]
}